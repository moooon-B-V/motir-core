{
  "name": "@motir/pages",
  "version": "0.1.0",
  "private": true,
  "description": "The pages module: the page model types, the pure tree rules (placement, cycle refusal, depth limit, fractional positions) and the record's constants. The app binds its ports at lib/pages/index.ts.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moooon-B-V/motir-core.git",
    "directory": "packages/pages"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tiptap/core": "^3.24.0",
    "@tiptap/extension-collaboration": "^3.24.0",
    "@tiptap/extension-image": "^3.24.0",
    "@tiptap/extension-link": "^3.24.0",
    "@tiptap/extension-table": "^3.24.0",
    "@tiptap/extension-task-item": "^3.24.0",
    "@tiptap/extension-task-list": "^3.24.0",
    "@tiptap/extensions": "^3.24.0",
    "@tiptap/pm": "^3.24.0",
    "@tiptap/react": "^3.24.0",
    "@tiptap/starter-kit": "^3.24.0",
    "@tiptap/suggestion": "^3.26.0",
    "@tiptap/y-tiptap": "^3.0.4",
    "fractional-indexing": "^3.2.0",
    "lucide-react": "^1.16.0",
    "markdown-it": "^14.2.0",
    "prosemirror-markdown": "^1.13.4",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.33"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.19.19",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}

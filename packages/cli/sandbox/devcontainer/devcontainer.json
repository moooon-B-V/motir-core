{
  "name": "Motir sandbox (base)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../../../..",
    "args": {
      "AGENT": "base"
    }
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "mounts": [
    "source=${localEnv:HOME}/.config/motir,target=/home/node/.config/motir,type=bind,readonly"
  ],
  "remoteUser": "node",
  "overrideCommand": true,
  "postAttachCommand": "motir --version"
}

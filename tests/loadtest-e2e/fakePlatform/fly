#!/usr/bin/env node
// THE FAKE `fly` (Story MOTIR-8538 · MOTIR-8682) — the loadtest end-to-end lane's
// stand-in for flyctl, put FIRST on the PATH of the spawned `pnpm loadtest:run`, so
// the run command's real runner (`spawnExec('fly', …)`), the preflight and the log
// capture call it exactly as they would call the real CLI.
//
// It implements the REAL commands' syntax as Fly documents it, so a call the real
// CLI would refuse fails here too, and it answers from ONE JSON state file
// (`$FAKE_PLATFORM_STATE/state.json`, written by ../globalSetup.ts). Every call is
// appended to `$FAKE_PLATFORM_STATE/calls.ndjson` before it is answered.
//
//   fly machine list --json -a <app>                 the app's machines, documented JSON
//   fly machine start|stop <id> -a <app>             flips the machine's state
//   fly scale count app=<n> -a <app> --yes           the documented `name=count` form
//   fly scale count <n> --process-group app -a <app> --yes
//   fly ssh console -a <app> --machine <id> -C <cmd> NOT run through a shell (below)
//   fly ssh sftp put|get --machine <id> -a <app> [-R] [-m <mode>] <src> <dst>
//   fly secrets list --json -a <staging app>         secret NAMES only, never values
//   fly logs -a <app> --json [--machine <id>]        replays the tee'd instance logs, then tails
//
// ── `fly ssh console -C` DOES NOT RUN ITS STRING THROUGH A SHELL ─────────────
// flyctl splits the string into words and executes them directly (Fly community
// answers, read 2026-10-15). So does this fake: the words are split with quote
// rules only — no globbing, no `|`, no `>` — and a command that needs a shell must
// be sent as `sh -c '<script>'`. A bare pipe reaches the program as a literal
// argument, as it does on Fly.
//
// ── THE GENERATOR MACHINE ────────────────────────────────────────────────────
// A command on the generator runs LOCALLY, inside a directory standing in for the
// machine's filesystem: `/opt/loadtest` (the baked k6 binary), the `/data` volume
// (listed in its own `/proc/mounts`, so the run command's volume check is emulated
// rather than skipped) and the `/dev/shm/loadtest` tmpfs. Those four paths are
// re-rooted in every word of the command, and in an uploaded `*.sh` (the run
// script is the one uploaded file that names them), the way a chroot would see
// them. The command runs with a machine's environment, not the operator's.

'use strict';

const { spawnSync } = require('node:child_process');
const fs = require('node:fs');
const path = require('node:path');

const stateDir = process.env.FAKE_PLATFORM_STATE;
if (!stateDir) {
  process.stderr.write('fake fly: FAKE_PLATFORM_STATE is not set\n');
  process.exit(2);
}
const statePath = path.join(stateDir, 'state.json');
const argv = process.argv.slice(2);

const readState = () => JSON.parse(fs.readFileSync(statePath, 'utf8'));
function writeState(state) {
  const tmp = `${statePath}.${process.pid}.tmp`;
  fs.writeFileSync(tmp, `${JSON.stringify(state, null, 2)}\n`);
  fs.renameSync(tmp, statePath);
}

fs.appendFileSync(
  path.join(stateDir, 'calls.ndjson'),
  `${JSON.stringify({ bin: 'fly', args: argv, at: new Date().toISOString() })}\n`,
);

function fail(message, code = 1) {
  process.stderr.write(`Error: ${message}\n`);
  process.exit(code);
}

/** Split `argv` into flags (by name) and positionals; `known` maps each flag to whether it takes a value. */
function parse(args, known) {
  const flags = {};
  const positionals = [];
  for (let i = 0; i < args.length; i += 1) {
    const a = args[i];
    if (a.startsWith('-') && a !== '-') {
      const eq = a.indexOf('=');
      const name = eq === -1 ? a : a.slice(0, eq);
      if (!(name in known)) fail(`unknown flag: ${name}`);
      if (known[name]) {
        const value = eq === -1 ? args[(i += 1)] : a.slice(eq + 1);
        if (value === undefined) fail(`flag needs an argument: ${name}`);
        flags[name] = value;
      } else {
        if (eq !== -1) fail(`flag takes no argument: ${name}`);
        flags[name] = true;
      }
    } else positionals.push(a);
  }
  return { flags, positionals };
}

const appOf = (flags) => flags['-a'] ?? flags['--app'] ?? fail('the app name is required (-a)');

function appState(state, name) {
  const app = state.apps[name];
  if (!app) fail(`Could not find App "${name}"`);
  return app;
}

/** A machine in the documented `fly machine list --json` shape (Fly Machines API machine config). */
function machineJson(m) {
  return {
    id: m.id,
    name: m.name,
    state: m.state,
    region: m.region,
    instance_id: `01J${m.id.toUpperCase()}`,
    private_ip: m.privateIp,
    image_ref: {
      registry: 'registry.fly.io',
      repository: m.repository,
      tag: m.tag,
      digest: `sha256:${m.digest}`,
      labels: { 'org.opencontainers.image.revision': m.tag },
    },
    config: {
      image: `registry.fly.io/${m.repository}:${m.tag}`,
      guest: m.guest,
      metadata: m.group ? { fly_process_group: m.group } : {},
      services: m.services,
    },
    created_at: m.createdAt,
    updated_at: m.updatedAt,
  };
}

const listed = (app) => app.machines.filter((m) => m.exists !== false);

function findMachine(app, id) {
  const m = listed(app).find((x) => x.id === id);
  if (!m) fail(`machine ${id} was not found`);
  return m;
}

// ── shell-free word splitting (quotes only) ──────────────────────────────────
function splitWords(command) {
  const words = [];
  let cur = '';
  let inWord = false;
  for (let i = 0; i < command.length; i += 1) {
    const c = command[i];
    if (c === "'") {
      const end = command.indexOf("'", i + 1);
      if (end === -1) fail('unterminated single quote in the -C command');
      cur += command.slice(i + 1, end);
      i = end;
      inWord = true;
    } else if (c === '"') {
      i += 1;
      while (i < command.length && command[i] !== '"') {
        if (command[i] === '\\' && i + 1 < command.length && '"\\$`'.includes(command[i + 1])) {
          i += 1;
        }
        cur += command[i];
        i += 1;
      }
      if (i >= command.length) fail('unterminated double quote in the -C command');
      inWord = true;
    } else if (c === '\\' && i + 1 < command.length) {
      cur += command[(i += 1)];
      inWord = true;
    } else if (/\s/.test(c)) {
      if (inWord) words.push(cur);
      cur = '';
      inWord = false;
    } else {
      cur += c;
      inWord = true;
    }
  }
  if (inWord) words.push(cur);
  return words;
}

// ── the generator's filesystem ───────────────────────────────────────────────
const MACHINE_PATHS = ['/opt/loadtest', '/dev/shm/loadtest', '/proc/mounts', '/data'];

function reroot(text, root) {
  let out = text;
  for (const p of MACHINE_PATHS) {
    const re = new RegExp(
      `(^|[\\s'"=(])${p.replace(/[.*+?^${}()|[\]\\/]/g, '\\$&')}(?=$|[/\\s'"):;])`,
      'g',
    );
    out = out.replace(re, (_, lead) => `${lead}${root}${p}`);
  }
  return out;
}

function machineEnv(state, root) {
  return {
    PATH: process.env.PATH,
    HOME: path.join(root, 'root'),
    LANG: 'C.UTF-8',
    TMPDIR: path.join(root, 'tmp'),
    FLY_APP_NAME: state.generatorApp,
    FLY_REGION: 'iad',
    K6_AUTO_EXTENSION_RESOLUTION: 'false',
  };
}

function requireStarted(m) {
  if (m.state !== 'started') fail(`machine ${m.id} is ${m.state}; start it before you ssh to it`);
}

// ── commands ─────────────────────────────────────────────────────────────────
function machineCmd(rest) {
  const [verb, ...args] = rest;
  if (verb === 'list' || verb === 'ls') {
    const { flags, positionals } = parse(args, {
      '--json': false,
      '-j': false,
      '-a': true,
      '--app': true,
    });
    if (positionals.length) fail(`unexpected argument ${positionals[0]}`);
    const state = readState();
    const app = appState(state, appOf(flags));
    if (!flags['--json'] && !flags['-j']) {
      for (const m of listed(app))
        process.stdout.write(`${m.id}\t${m.name}\t${m.state}\t${m.region}\n`);
      return;
    }
    process.stdout.write(`${JSON.stringify(listed(app).map(machineJson), null, 2)}\n`);
    return;
  }
  if (verb === 'start' || verb === 'stop') {
    const { flags, positionals } = parse(args, { '-a': true, '--app': true });
    if (positionals.length !== 1) fail(`${verb} takes one machine id`);
    const state = readState();
    const name = appOf(flags);
    const m = findMachine(appState(state, name), positionals[0]);
    m.state = verb === 'start' ? 'started' : 'stopped';
    m.updatedAt = new Date().toISOString();
    writeState(state);
    process.stdout.write(
      `${positionals[0]} has been ${verb === 'start' ? 'started' : 'stopped'}\n`,
    );
    return;
  }
  fail(`unknown command "machine ${verb}"`);
}

function scaleCmd(rest) {
  const [verb, ...args] = rest;
  if (verb !== 'count') fail(`unknown command "scale ${verb}"`);
  const { flags, positionals } = parse(args, {
    '-a': true,
    '--app': true,
    '--yes': false,
    '-y': false,
    '--process-group': true,
    '--region': true,
  });
  if (positionals.length !== 1) fail('scale count takes one count');
  let group = flags['--process-group'] ?? 'app';
  let n;
  const named = /^([a-z][a-z0-9_-]*)=(\d+)$/.exec(positionals[0]);
  if (named) {
    if (flags['--process-group'])
      fail('a name=count argument cannot be combined with --process-group');
    group = named[1];
    n = Number(named[2]);
  } else if (/^\d+$/.test(positionals[0])) n = Number(positionals[0]);
  else fail(`invalid count: ${positionals[0]}`);
  if (!flags['--yes'] && !flags['-y']) fail('scale count needs --yes when not run interactively');
  const state = readState();
  const app = appState(state, appOf(flags));
  const inGroup = app.machines.filter((m) => m.group === group);
  if (inGroup.length < n) fail(`the fake has only ${inGroup.length} ${group} machines to scale to`);
  inGroup.forEach((m, i) => {
    const want = i < n;
    if (want && m.exists === false) {
      m.exists = true;
      m.state = 'started';
      m.updatedAt = new Date().toISOString();
    } else if (!want && m.exists !== false) {
      m.exists = false;
    }
  });
  writeState(state);
  process.stdout.write(
    `App '${appOf(flags)}' is going to be scaled according to this plan:\n  ${group}: ${n}\n`,
  );
}

function sshConsole(args) {
  const { flags, positionals } = parse(args, {
    '-a': true,
    '--app': true,
    '--machine': true,
    '-s': false,
    '--select': false,
    '-C': true,
    '--command': true,
  });
  if (positionals.length) fail(`unexpected argument ${positionals[0]}`);
  const command = flags['-C'] ?? flags['--command'];
  if (command === undefined) fail('an interactive session is not available here; pass -C');
  const state = readState();
  const name = appOf(flags);
  const app = appState(state, name);
  const id = flags['--machine'] ?? listed(app)[0]?.id;
  const m = findMachine(app, id);
  requireStarted(m);
  const words = splitWords(command);
  if (words.length === 0) fail('empty command');

  if (name === state.generatorApp) {
    const root = state.generatorRoot;
    const [bin, ...rest] = words.map((w) => reroot(w, root));
    const r = spawnSync(bin, rest, {
      cwd: path.join(root, 'root'),
      env: machineEnv(state, root),
      stdio: ['ignore', 'pipe', 'pipe'],
      maxBuffer: 64 * 1024 * 1024,
    });
    if (r.error) {
      process.stderr.write(`exec: "${words[0]}": executable file not found in $PATH\n`);
      process.exit(127);
    }
    process.stdout.write(r.stdout);
    process.stderr.write(r.stderr);
    process.exit(r.status ?? 1);
  }

  // A staging (or worker) machine: its environment is the fixture's.
  if (words[0] === 'printenv') {
    const env = {
      ...state.machineEnv,
      FLY_MACHINE_ID: m.id,
      FLY_APP_NAME: name,
      FLY_PROCESS_GROUP: m.group,
    };
    if (words.length === 1) {
      for (const [k, v] of Object.entries(env)) process.stdout.write(`${k}=${v}\n`);
      return;
    }
    let missing = false;
    for (const k of words.slice(1)) {
      if (k in env) process.stdout.write(`${env[k]}\n`);
      else missing = true;
    }
    process.exit(missing ? 1 : 0);
  }
  process.stderr.write(`exec: "${words[0]}": not available on the fake ${name} machine\n`);
  process.exit(127);
}

function sshSftp(rest) {
  const [verb, ...args] = rest;
  if (verb !== 'put' && verb !== 'get') fail(`unknown command "ssh sftp ${verb}"`);
  const { flags, positionals } = parse(args, {
    '-a': true,
    '--app': true,
    '--machine': true,
    '-R': false,
    '--recursive': false,
    '-m': true,
    '--mode': true,
  });
  if (positionals.length !== 2) fail(`sftp ${verb} takes a source and a destination`);
  const state = readState();
  const name = appOf(flags);
  if (name !== state.generatorApp) fail(`the fake serves sftp on ${state.generatorApp} only`);
  const m = findMachine(appState(state, name), flags['--machine']);
  requireStarted(m);
  const root = state.generatorRoot;
  const [src, dst] = positionals;
  if (verb === 'put') {
    const remote = reroot(dst, root);
    if (!fs.existsSync(src)) fail(`${src}: no such file or directory`);
    fs.mkdirSync(path.dirname(remote), { recursive: true });
    if (fs.statSync(src).isDirectory()) {
      if (!flags['-R'] && !flags['--recursive']) fail(`${src} is a directory; pass -R`);
      fs.cpSync(src, remote, { recursive: true, dereference: true });
    } else {
      fs.copyFileSync(src, remote);
      if (remote.endsWith('.sh'))
        fs.writeFileSync(remote, reroot(fs.readFileSync(remote, 'utf8'), root));
    }
    const mode = flags['-m'] ?? flags['--mode'];
    if (mode) fs.chmodSync(remote, parseInt(mode, 8));
    process.stdout.write(`${fs.statSync(src).size} bytes written\n`);
    return;
  }
  const remote = reroot(src, root);
  if (!fs.existsSync(remote) || fs.statSync(remote).isDirectory())
    fail(`${src}: file does not exist`);
  fs.mkdirSync(path.dirname(dst), { recursive: true });
  fs.copyFileSync(remote, dst);
  process.stdout.write(`${fs.statSync(dst).size} bytes read\n`);
}

function secretsCmd(rest) {
  const [verb, ...args] = rest;
  if (verb !== 'list' && verb !== 'ls') fail(`unknown command "secrets ${verb}"`);
  const { flags, positionals } = parse(args, {
    '--json': false,
    '-j': false,
    '-a': true,
    '--app': true,
  });
  if (positionals.length) fail(`unexpected argument ${positionals[0]}`);
  const state = readState();
  const name = appOf(flags);
  if (name !== state.stagingApp) fail(`the fake holds no secrets for ${name}`);
  const rows = state.secretNames.map((n) => ({
    Name: n,
    Digest: `${n.length.toString(16).padStart(16, '0')}`,
    CreatedAt: '2026-10-14T03:00:00Z',
  }));
  if (flags['--json'] || flags['-j']) process.stdout.write(`${JSON.stringify(rows, null, 2)}\n`);
  else for (const r of rows) process.stdout.write(`${r.Name}\t${r.Digest}\n`);
}

function logsCmd(args) {
  const { flags, positionals } = parse(args, {
    '-a': true,
    '--app': true,
    '--json': false,
    '-j': false,
    '--machine': true,
    '-i': true,
    '--instance': true,
    '--no-tail': false,
    '-n': false,
    '--region': true,
    '-r': true,
  });
  if (positionals.length) fail(`unexpected argument ${positionals[0]}`);
  const state = readState();
  const name = appOf(flags);
  appState(state, name);
  const only = flags['--machine'] ?? flags['-i'] ?? flags['--instance'] ?? null;
  const files = name === state.stagingApp ? Object.entries(state.logFiles) : [];
  const offsets = new Map(files.map(([id]) => [id, 0]));
  const emit = (line) => {
    if (!line.trim()) return;
    if (flags['--json'] || flags['-j']) process.stdout.write(`${line}\n`);
    else {
      const e = JSON.parse(line);
      process.stdout.write(
        `${e.timestamp} app[${e.instance}] ${e.region} [${e.level}] ${e.message}\n`,
      );
    }
  };
  const drain = () => {
    for (const [id, file] of files) {
      if (only && only !== id) continue;
      let text;
      try {
        text = fs.readFileSync(file, 'utf8');
      } catch {
        continue;
      }
      const from = offsets.get(id);
      const end = text.lastIndexOf('\n') + 1;
      if (end <= from) continue;
      for (const line of text.slice(from, end).split('\n')) emit(line);
      offsets.set(id, end);
    }
  };
  drain();
  if (flags['--no-tail'] || flags['-n']) return;
  setInterval(drain, 500);
  process.on('SIGTERM', () => process.exit(0));
  process.on('SIGINT', () => process.exit(0));
}

const [top, ...rest] = argv;
switch (top) {
  case 'machine':
  case 'machines':
  case 'm':
    machineCmd(rest);
    break;
  case 'scale':
    scaleCmd(rest);
    break;
  case 'ssh':
    if (rest[0] === 'console') sshConsole(rest.slice(1));
    else if (rest[0] === 'sftp') sshSftp(rest.slice(1));
    else fail(`unknown command "ssh ${rest[0]}"`);
    break;
  case 'secrets':
    secretsCmd(rest);
    break;
  case 'logs':
    logsCmd(rest);
    break;
  default:
    fail(
      `unknown command "${top}" for "fly" (the fake answers only the commands the load test makes)`,
    );
}

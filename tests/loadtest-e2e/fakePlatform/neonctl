#!/usr/bin/env node
// THE FAKE `neonctl` (Story MOTIR-8538 · MOTIR-8682) — the loadtest end-to-end
// lane's stand-in for Neon's CLI, first on the spawned command's PATH beside the
// fake `fly`. It answers from `$FAKE_PLATFORM_STATE/state.json` and appends every
// call to `$FAKE_PLATFORM_STATE/calls.ndjson`.
//
// The syntax is the one Neon's CLI reference documents (read 2026-10-15), and it
// is STRICT the way the real CLI's argument parser is — an unknown flag is refused:
//
//   neonctl connection-string <branch> --project-id <id> --role-name <name> [--pooled]
//       the branch is a POSITIONAL argument (there is no `--branch` flag); the
//       DIRECT host by default, `--pooled` adds the `-pooler` suffix
//   neonctl branches get <branch> --project-id <id> -o json
//       the documented branch fields (id, parent_id, parent_lsn, parent_timestamp,
//       created_at, updated_at, current_state, protected, endpoints)
//   neonctl branches reset <branch> --parent --project-id <id>
//       `--parent` is a BOOLEAN flag with no value; the call is logged and the
//       branch keeps its id (the refresh is a runbook step: the lane's cases never
//       call it, and this exists so the runbook's command form is syntax-checked)

'use strict';

const fs = require('node:fs');
const path = require('node:path');

const stateDir = process.env.FAKE_PLATFORM_STATE;
if (!stateDir) {
  process.stderr.write('fake neonctl: FAKE_PLATFORM_STATE is not set\n');
  process.exit(2);
}
const argv = process.argv.slice(2);
fs.appendFileSync(
  path.join(stateDir, 'calls.ndjson'),
  `${JSON.stringify({ bin: 'neonctl', args: argv, at: new Date().toISOString() })}\n`,
);
const state = JSON.parse(fs.readFileSync(path.join(stateDir, 'state.json'), 'utf8'));
const neon = state.neon;

function fail(message, code = 1) {
  process.stderr.write(`ERROR: ${message}\n`);
  process.exit(code);
}

/** Strict parse: `known` maps each flag to whether it takes a value. */
function parse(args, known) {
  const flags = {};
  const positionals = [];
  for (let i = 0; i < args.length; i += 1) {
    const a = args[i];
    if (!a.startsWith('-')) {
      positionals.push(a);
      continue;
    }
    const eq = a.indexOf('=');
    const name = eq === -1 ? a : a.slice(0, eq);
    if (!(name in known)) fail(`Unknown argument: ${name.replace(/^-+/, '')}`);
    if (known[name]) {
      const value = eq === -1 ? args[(i += 1)] : a.slice(eq + 1);
      if (value === undefined || value.startsWith('-'))
        fail(`Not enough arguments following: ${name}`);
      flags[name] = value;
    } else {
      if (eq !== -1) fail(`${name} is a boolean flag and takes no value`);
      flags[name] = true;
    }
  }
  return { flags, positionals };
}

const GLOBAL = { '--api-key': true, '--config-dir': true, '--no-color': false };

function branchOf(positionals, verb) {
  if (positionals.length !== 1) {
    fail(
      `${verb} takes exactly one branch (id or name) as its positional argument, got ${positionals.length}`,
    );
  }
  const b = positionals[0];
  if (b !== neon.branch.id && b !== neon.branch.name) fail(`branch ${b} not found`);
  return b;
}

function project(flags) {
  const p = flags['--project-id'];
  if (!p) fail('Missing required argument: project-id');
  if (p !== neon.projectId) fail(`project ${p} not found`);
}

const [top, ...rest] = argv;
if (top === 'connection-string' || top === 'cs') {
  const { flags, positionals } = parse(rest, {
    ...GLOBAL,
    '--project-id': true,
    '--role-name': true,
    '--database-name': true,
    '--pooled': false,
    '--ssl': true,
    '--prisma': false,
    '--endpoint-type': true,
    '--extended': false,
  });
  project(flags);
  branchOf(positionals, 'connection-string');
  if (flags['--role-name'] && flags['--role-name'] !== neon.roleName) {
    fail(`role ${flags['--role-name']} not found`);
  }
  const url = new URL(neon.connectionString);
  if (flags['--pooled']) {
    const [first, ...others] = url.hostname.split('.');
    url.hostname = [`${first}-pooler`, ...others].join('.');
  }
  process.stdout.write(`${url.toString()}\n`);
} else if (top === 'branches' || top === 'branch') {
  const [verb, ...args] = rest;
  if (verb === 'get') {
    const { flags, positionals } = parse(args, {
      ...GLOBAL,
      '--project-id': true,
      '-o': true,
      '--output': true,
    });
    project(flags);
    branchOf(positionals, 'branches get');
    const out = flags['-o'] ?? flags['--output'] ?? 'table';
    if (out === 'json') process.stdout.write(`${JSON.stringify(neon.branch, null, 2)}\n`);
    else if (out === 'yaml') fail('the fake prints json or table only');
    else
      process.stdout.write(
        `${neon.branch.id}\t${neon.branch.name}\t${neon.branch.current_state}\n`,
      );
  } else if (verb === 'reset') {
    const { flags, positionals } = parse(args, {
      ...GLOBAL,
      '--project-id': true,
      '--parent': false,
      '--preserve-under-name': true,
      '-o': true,
      '--output': true,
    });
    project(flags);
    branchOf(positionals, 'branches reset');
    if (!flags['--parent']) fail('Missing required argument: parent');
    process.stdout.write(`${JSON.stringify({ branch: neon.branch, operations: [] }, null, 2)}\n`);
  } else {
    fail(`Unknown command: branches ${verb}`);
  }
} else {
  fail(`Unknown command: ${top} (the fake answers only the commands the load test makes)`);
}

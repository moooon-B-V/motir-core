exports[`PlanningCanvas motion — OFF > renders byte-identically to motion={false} and to the pre-motion canvas 1`] = `"<div class="relative h-full w-full overflow-hidden"><div role="application" aria-label="Planning canvas" tabindex="0" class="absolute inset-0 cursor-grab touch-none bg-(--el-canvas) focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--focus-ring-color) active:cursor-grabbing" style="touch-action: none;" data-testid="planning-canvas"><svg class="absolute h-0 w-0" aria-hidden="true"><defs><marker id="_r_ID_-committed" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" class="fill-(--el-canvas-edge-committed)"></path></marker><marker id="_r_ID_-pending" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" class="fill-(--el-canvas-edge-pending)"></path></marker><marker id="_r_ID_-warning" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" class="fill-(--el-warning)"></path></marker><marker id="_r_ID_-emphasis" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" class="fill-(--el-accent-on-surface)"></path></marker><marker id="_r_ID_-running" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" class="fill-(--el-status-in-progress)"></path></marker></defs></svg><svg class="pointer-events-none absolute top-0 left-0 h-full w-full" style="transform: translate(0px, 0px) scale(1); transform-origin: 0 0; overflow: visible;" aria-hidden="true" data-testid="canvas-edges"><path d="M300,33.6 C340,33.6 260,60 300,60" fill="none" class="stroke-(--el-accent-on-surface)" stroke-width="3" stroke-linecap="round" marker-end="url(#_r_ID_-emphasis)" vector-effect="non-scaling-stroke" styl
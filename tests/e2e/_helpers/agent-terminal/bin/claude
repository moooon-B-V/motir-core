#!/usr/bin/env bash
# A STUB of the Claude Code CLI — the acceptance lane's stand-in for the vendor's
# sign-in (Story MOTIR-6861 · MOTIR-6943). TEST-ONLY: it lives under tests/e2e/,
# only the lane's terminal host (host.ts) puts it on a shell's PATH, and nothing
# in the image or the app refers to it. It NEVER reaches a vendor.
#
# What it does is the shape of the real flow, and no more: `/login` prints a URL,
# accepts a pasted code, and writes the credential file the terminal server's
# sign-in check stats (`$CLAUDE_CONFIG_DIR/.credentials.json`,
# docs/decisions/agent-terminal.md Q7). The file's content is a placeholder.
#
# `claude -p <prompt>` is the UNATTENDED mode a card's run starts it in (Story
# MOTIR-6864 · MOTIR-7031, `motir-run.py`): it prints its work, then keeps working
# — a progress line every few seconds — until the file named by
# `MOTIR_E2E_RELEASE` exists, so the spec decides when the work is done without a
# clock. Then it says so and exits 0.
#
# Any OTHER arguments make it the CHAT's binary (Story MOTIR-6863 · MOTIR-7019):
# the headless turn (`-p --output-format stream-json …`) and `auth status --json`
# that docs/decisions/agent-chat.md Q2/Q3 record are answered by
# ../vendor-stub.mjs, which refuses (exit 2) anything else.
set -u
if [ "${1:-}" = "-p" ] && [ "${2:-}" != "--output-format" ]; then
  echo "Claude Code (stub) · ${2:-no prompt}"
  echo "Reading the work item and the repository…"
  echo "Editing src/invoices/export.ts — invoices export as CSV"
  release="${MOTIR_E2E_RELEASE:-}"
  waited=0
  while [ -n "$release" ] && [ ! -e "$release" ]; do
    sleep 1
    waited=$((waited + 1))
    if [ $((waited % 6)) -eq 0 ]; then echo "· still working (${waited}s)"; fi
  done
  echo "Tests pass. Committed the change to the run's branch."
  exit 0
fi
if [ "$#" -gt 0 ]; then
  exec node "$(dirname "$0")/../vendor-stub.mjs" claude "$@"
fi
echo "Claude Code (stub for the Motir acceptance lane)"
echo "Type /login to sign in, /exit to leave."
while IFS= read -r -p "> " line; do
  case "$line" in
    /login)
      echo "Browse to this URL to sign in:"
      echo "https://claude.invalid/oauth/authorize?client=e2e-stub"
      IFS= read -r -p "Paste code here > " code || exit 1
      if [ -z "$code" ]; then
        echo "No code pasted; nothing changed."
        continue
      fi
      dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
      mkdir -p "$dir"
      printf '{"stub":"e2e"}\n' > "$dir/.credentials.json"
      chmod 600 "$dir/.credentials.json"
      echo "Login successful."
      ;;
    /exit) exit 0 ;;
    "") ;;
    *) echo "(stub) $line" ;;
  esac
done

{
  // Playwright-only module resolution (Subtask MOTIR-921).
  //
  // Identical to the root tsconfig except for ONE added path mapping:
  // `server-only` → the empty stub `tests/stubs/server-only.ts`.
  //
  // `import 'server-only'` is a Next BUILD-TIME marker with no plain-node
  // resolution — Next resolves it (to a no-op on the server, to a throw inside a
  // client bundle) so a server-only module can never reach the browser. A spec
  // that seeds through a service reaching `lib/ai/motirAiClient` therefore dies
  // at import with ERR_MODULE_NOT_FOUND in the Playwright process, before a
  // single test is collected. `vitest.config.ts` already solves this the same
  // way, against the same stub; this is that decision extended to the E2E runner
  // rather than a second mechanism.
  //
  // The BOUNDARY IS UNAFFECTED: this file is loaded only by the Playwright
  // configs (`tsconfig:` below), never by `next build` / `tsc` / eslint, so the
  // real open-core guard the marker exists for keeps being enforced everywhere
  // it matters. The stub is empty, so a module importing it gains nothing — it
  // simply stops throwing on resolution.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "server-only": ["./tests/stubs/server-only.ts"]
    }
  }
}

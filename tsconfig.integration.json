{
  // ── The INTEGRATION-TESTS project (MOTIR-736) ───────────────────────────────
  //
  // `tests/integration/**`'s suites, split out of `tsconfig.tests.json` the way
  // `tsconfig.components.json` was: the tests program had reached 90.1% of the
  // heap budget (`scripts/ci/assert-typecheck-headroom.mjs`) on Story 10.2's
  // ordinary additions, from 88.2% on main. These suites are LEAVES — nothing
  // else imports a `*.test.ts` — so this project references the tests project
  // and reads its helpers (including `tests/integration/monitors/_monitorLinkFixtures.ts`,
  // which other suites import and therefore stays there) as declarations.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": ".",
    "outDir": ".tsout/integration",
    "tsBuildInfoFile": ".tsout/integration/tsconfig.tsbuildinfo"
  },
  "include": ["tests/integration/**/*.test.ts", "tests/integration/**/*.test.tsx"],
  "exclude": ["node_modules", "packages", ".tsout"],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.scripts.json" },
    { "path": "./tsconfig.tests.json" }
  ]
}

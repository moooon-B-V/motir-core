# Build-context excludes. Two images build with this root as their context:
# the production app (./Dockerfile) and the `motir auto` sandbox
# (packages/cli/sandbox/Dockerfile), the latter because `pnpm install
# --frozen-lockfile` validates the lockfile against every workspace manifest.
# Keep the context to SOURCE — installed/generated trees are rebuilt inside the
# image and would otherwise dominate the upload.
node_modules
**/node_modules
# Prisma's generated client. The production image's builder runs `prisma
# generate` explicitly; the sandbox never generates it at all (its install is
# `--ignore-scripts` and the CLI has no prisma dependency — MOTIR-6498). Either
# way the host's copy is waste in the context and a chance to bake in a stale one.
/generated
.git
.next
out
build
coverage
dist
**/dist
packages/*/dist
test-results
playwright-report
blob-report
.turbo
.vercel

# Local secrets and environment — never part of an image context. The sandbox
# receives its credential through a read-only mount at run time, not a layer.
.env
.env.*
!.env.example

# Editor / OS noise.
.DS_Store
.idea
.vscode
*.log
